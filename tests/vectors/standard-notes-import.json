{
 "slug": "standard-notes-import",
 "module": "standard-notes-import/src/importer",
 "function": "planImport",
 "cases": [
  {
   "name": "Plain legacy note creates Markdown with its UUID",
   "args": [
    {
     "items": [
      {
       "uuid": "n1",
       "content_type": "Note",
       "content": {
        "title": "Hello",
        "text": "Hello",
        "references": []
       }
      }
     ]
    }
   ],
   "expected": {
    "notes": [
     {
      "uuid": "n1",
      "title": "Hello",
      "text": "Hello",
      "tags": [],
      "path": "Standard Notes/Hello--n1.md"
     }
    ],
    "issues": [],
    "changed": []
   }
  },
  {
   "name": "Version 004 note preserves its text",
   "args": [
    {
     "items": [
      {
       "uuid": "n1",
       "content_type": "Note",
       "content": {
